#!/bin/sh
# Generated by configure.
# Run this file to recreate the current configuration.
# Compiler output produced by configure, useful for debugging
# configure, is in config.log if it exists.
unset AR
unset AS
unset CC
unset CFLAGS
unset CXX
unset CXXFLAGS
unset DLLTOOL
unset LD
unset LDFLAGS
unset LD_LIBRARY_PATH
unset NM
unset OBJCFLAGS
unset OBJCOPY
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
unset PKG_CONFIG
unset PKG_CONFIG_LIBDIR
unset PKG_CONFIG_PATH
unset PYTHON
unset QEMU_GA_MANUFACTURER
unset QEMU_GA_DISTRO
unset QEMU_GA_VERSION
unset SDL2_CONFIG
unset SMBD
unset STRIP
unset WIDL
unset WINDRES
unset WINDMC
exec '../configure' '--disable-download' '--target-list=x86_64-softmmu' '--with-suffix=kvm' '--audio-drv-list=alsa' '--disable-capstone' '--disable-gtk' '--disable-guest-agent' '--disable-libnfs' '--disable-libssh' '--disable-sdl' '--disable-smartcard' '--disable-strip' '--disable-xen' '--enable-curl' '--enable-fuse' '--enable-gnutls' '--enable-libiscsi' '--enable-libusb' '--enable-linux-aio' '--enable-linux-io-uring' '--enable-numa' '--enable-rbd' '--enable-seccomp' '--enable-slirp' '--enable-spice' '--enable-usb-redir' '--enable-virglrenderer' '--enable-virtfs' '--enable-zstd' "$@"
